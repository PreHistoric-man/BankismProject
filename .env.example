# =============================================================================
# BANKISM — LOCAL / SIMULATED BANKING SECURITY DEMO CONFIGURATION
# =============================================================================
# All variables below have safe, documented development defaults in
# `bankism/backend/app/config.py` and work out-of-the-box without manual input.
# No external banking or AI API keys are required or used.

# -----------------------------------------------------------------------------
# 1. Optional Runtime & Server Settings
# -----------------------------------------------------------------------------
BANKISM_ENV=development
BANKISM_DEBUG=false
BANKISM_HOST=0.0.0.0
BANKISM_PORT=8000
BANKISM_DATABASE_PATH=bankism_ledger.db
BANKISM_BEHAVIORAL_POLICY_VERSION=phase3-v1.0.0

# -----------------------------------------------------------------------------
# 2. Feature Flags & Security Guardrails (Fail-Closed Preserved)
# -----------------------------------------------------------------------------
# Note: /firewall/inspect permanently enforces execution_permitted=False
# regardless of BANKISM_ALLOW_TRANSACTION_EXECUTION.
BANKISM_ALLOW_TRANSACTION_EXECUTION=false
BANKISM_ENABLE_HEURISTIC_DETECTION=true
BANKISM_ENABLE_PAYMENT_METADATA_CHECKS=true
BANKISM_MASK_LOG_SENSITIVE_DATA=true
BANKISM_HIGH_BEHAVIORAL_RISK_REQUIRES_DUAL_APPROVAL=true
BANKISM_ENABLE_TOCTOU_WATERMARK_CHECK=true

# -----------------------------------------------------------------------------
# 3. Numeric Thresholds — Phase 1 & 2 (AI Firewall & Deterministic Policy)
# -----------------------------------------------------------------------------
BANKISM_RISK_BLOCK_THRESHOLD=0.70
BANKISM_RISK_REVIEW_THRESHOLD=0.35
BANKISM_HIGH_AMOUNT_THRESHOLD=10000.00
BANKISM_HIGH_RISK_DUAL_APPROVAL_THRESHOLD=10000.00
BANKISM_TICKET_EXPIRY_SECONDS=300
BANKISM_DUAL_APPROVAL_EXPIRY_SECONDS=3600

# -----------------------------------------------------------------------------
# 4. Numeric Thresholds — Phase 3 (Behavioral Risk & User Threat Profiling)
# -----------------------------------------------------------------------------
BANKISM_MIN_HISTORY_TRANSACTIONS=3
BANKISM_BEHAVIORAL_WINDOW_DAYS=30
BANKISM_BEHAVIORAL_RISK_MEDIUM_THRESHOLD=25.0
BANKISM_BEHAVIORAL_RISK_HIGH_THRESHOLD=50.0
BANKISM_BEHAVIORAL_RISK_CRITICAL_THRESHOLD=75.0
BANKISM_AMOUNT_SPIKE_Z_SCORE_THRESHOLD=2.5
BANKISM_AMOUNT_SPIKE_RATIO_THRESHOLD=3.0
BANKISM_VELOCITY_HOURLY_BURST_THRESHOLD=3
BANKISM_VELOCITY_DAILY_BURST_THRESHOLD=8
BANKISM_REPEATED_FAILED_ATTEMPTS_THRESHOLD=3
BANKISM_RISK_ASSESSMENT_RETENTION_DAYS=90
